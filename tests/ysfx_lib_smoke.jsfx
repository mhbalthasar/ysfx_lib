desc: TuneLab ysfx_lib smoke
author: TuneLab contributors
slider1:1<0,2,0.01>Gain
slider2:0.5<0,1,0.01>Mix

@init
gain = slider1;
mix = slider2;
custom = 1234;

@slider
gain = slider1;
mix = slider2;

@block
frames = 64;

@sample
spl0 = spl0 * gain;
spl1 = spl1 * gain;

@serialize
file_var(0, custom);

@gfx
gfx_set(1, 0, 0, 1);
gfx_rect(0, 0, gfx_w, gfx_h);
